# --- Application ---
APP_NAME=DEVO+
ENVIRONMENT=development

# --- Database ---
# SQLite is used by default. The relative path is rewritten to live under
# /data when present (Fly.io persistent volume) or ./var/ in development.
DATABASE_URL=sqlite+aiosqlite:///./devo_plus.db

# --- Auth ---
# Required for Google Sign-In. Create one at https://console.cloud.google.com/apis/credentials
# and add http://localhost:5173 (and your tunnel hostname) to the Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# Used to sign your own session tokens. Set a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=43200

# --- Cloudflare Turnstile (optional, free) ---
# https://developers.cloudflare.com/turnstile/get-started/
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- CORS ---
CORS_ORIGINS=*
